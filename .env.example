# Copy to .env and fill in what you need. Every line is optional.

# --- Basics ---
# PORT=8080
# TZ=America/Denver                 # your time zone (reminder timing)
# SYNC_TOKEN=pick-a-long-password    # the app asks for it once per device
# APP_URL=http://192.168.1.20:8080   # address used in reminder links and calendar events
# CORS_ORIGIN=https://ryelikebread.github.io   # lets the GitHub Pages copy sync with this server (needs https on the server)

# --- Devil's advocate (local AI) ---
# DEVIL_MODEL=qwen3:8b               # qwen3:4b (lighter), gemma3:12b or qwen3:14b (better, needs more RAM/GPU)
# DEVIL_AUTO_PULL=1                  # download the model on first start
# DEVIL_TIMEOUT_SEC=300
# DEVIL_MAX_TOKENS=900

# --- Reminders (pick any) ---
# REMINDER_HOUR=9
# REMINDER_REPEAT_DAYS=7
# Phone push with the free ntfy app: subscribe to the same topic in the app.
# NTFY_URL=https://ntfy.sh/gut-check-change-this-to-something-random
# NTFY_TOKEN=
# Chat webhook (Discord, Slack, Mattermost, Home Assistant...):
# WEBHOOK_URL=
# Email:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=starttls               # tls for port 465, none for a local relay
# SMTP_USER=you@gmail.com
# SMTP_PASS=an-app-password
# SMTP_FROM=Gut Check <you@gmail.com>
# REMINDER_EMAIL_TO=you@gmail.com

# --- Backups ---
# BACKUP_MIN_INTERVAL_MIN=10
# BACKUP_KEEP=500
